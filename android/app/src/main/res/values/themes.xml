<resources>
    <style name="Theme.Rajgar" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rg_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Rajgar.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rg_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Rajgar</item>
    </style>
</resources>
